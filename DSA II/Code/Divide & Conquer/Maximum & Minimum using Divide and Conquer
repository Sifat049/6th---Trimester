#include <iostream>
#include <vector>
using namespace std;

// Find max and min
vector<int> f(vector<int>& a, int l, int h) {

    // One element
    if (l == h)
        return {a[l], a[l]};

    // Two elements
    if (h == l + 1) {
        if (a[l] > a[h])
            return {a[l], a[h]};
        else
            return {a[h], a[l]};
    }

    // Divide
    int m = (l + h) / 2;

    // Left and right
    vector<int> x = f(a, l, m);
    vector<int> y = f(a, m + 1, h);

    // Combine
    int mx = max(x[0], y[0]);
    int mn = min(x[1], y[1]);

    return {mx, mn};
}

int main() {

    vector<int> a = {180, 165, 175, 190};

    vector<int> r = f(a, 0, a.size() - 1);

    cout << "Maximum = " << r[0] << endl;
    cout << "Minimum = " << r[1] << endl;

    return 0;
}
